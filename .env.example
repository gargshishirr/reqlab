# ─────────────────────────────────────────────────────────────
# ReqLab environment configuration
# Copy this file to ".env" and adjust the values as needed.
# ─────────────────────────────────────────────────────────────

# HTTP server port
PORT=4000

# Host to bind to (0.0.0.0 makes it reachable from other machines / containers)
HOST=0.0.0.0

# ── Proxy behaviour ──────────────────────────────────────────
# Default timeout for forwarded requests (ms). Per-request overrides are capped
# at PROXY_MAX_TIMEOUT.
PROXY_TIMEOUT_MS=30000
PROXY_MAX_TIMEOUT=120000

# Maximum response body size kept and returned to the UI (bytes). Larger
# responses are truncated. Default 25 MB.
MAX_RESPONSE_BYTES=26214400

# ── Security ─────────────────────────────────────────────────
# When "true", the proxy refuses to forward requests to loopback/private
# network addresses (helps mitigate SSRF if you expose ReqLab publicly).
# Leave "false" for local development where you test localhost APIs.
BLOCK_PRIVATE_HOSTS=false

# ── Persistence ──────────────────────────────────────────────
# ReqLab is STATELESS: the server stores nothing on disk. All of your data
# (collections, environments, history) lives in your browser's localStorage,
# so tokens/secrets never touch the server. There is nothing to configure here.
