# ─────────────────────────────────────────────────────────────
# ReqLab environment configuration
# Copy this file to ".env" and adjust the values as needed.
# ─────────────────────────────────────────────────────────────

# HTTP server port
PORT=4000

# Host to bind to (0.0.0.0 makes it reachable from other machines / containers)
HOST=0.0.0.0

# ── Proxy behaviour ──────────────────────────────────────────
# Default timeout for forwarded requests (ms). Per-request overrides are capped
# at PROXY_MAX_TIMEOUT.
PROXY_TIMEOUT_MS=30000
PROXY_MAX_TIMEOUT=120000

# Maximum response body size kept and returned to the UI (bytes). Larger
# responses are truncated. Default 25 MB.
MAX_RESPONSE_BYTES=26214400

# Maximum size of a request sent to ReqLab's own API (bytes). Default 50 MB.
MAX_BODY_BYTES=52428800

# ── Password protection ──────────────────────────────────────
# Set a password to make this copy private: the web page and the API then ask
# you to sign in first. Use at least 8 characters (12 or more is better).
# Wrap it in single quotes if it has spaces, # or $ in it. Empty (or "off")
# means no password, which is fine on your own computer.
REQLAB_PASSWORD=

# Optional: ask for a user name as well.
REQLAB_USERNAME=

# A long random string that signs the sign-in cookie, so you stay signed in
# when the server restarts. Without it you sign in again after each restart.
# Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long a sign-in lasts, in hours.
SESSION_HOURS=12

# ── Security ─────────────────────────────────────────────────
# When "true", the proxy refuses to forward requests to loopback/private
# network addresses (helps mitigate SSRF if you expose ReqLab publicly).
# Domain names are resolved, every redirect hop is checked, and the address
# is checked again at the moment of connecting.
# Leave "false" for local development where you test localhost APIs. Then
# ReqLab only answers on localhost and IP addresses unless a password is set.
BLOCK_PRIVATE_HOSTS=false

# ── Public instances ─────────────────────────────────────────
# Demo mode for a public copy without a password: only call these hosts
# (comma separated; "*.example.com" allows its subdomains). Leave empty to
# allow any host. Not used when REQLAB_PASSWORD is set.
ALLOWED_HOSTS=

# Proxied requests allowed each minute per visitor and for the whole server
# (0 = no limit).
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_TOTAL_PER_MINUTE=0

# A header your host's own proxy sets to the visitor's IP address, used to tell
# visitors apart for the rate limit and the wrong-password lockout
# (cf-connecting-ip on Render). Leave empty to use the connecting address.
# Never use a header visitors can set themselves.
CLIENT_IP_HEADER=

# ── Persistence ──────────────────────────────────────────────
# ReqLab is STATELESS: the server stores nothing on disk. All of your data
# (collections, environments, history) lives in your browser's localStorage,
# so tokens/secrets never touch the server. There is nothing to configure here.
